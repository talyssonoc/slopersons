~ Procedures are values: build them, store them, pass them around.
proc adder k
| n | n + k

5 -> adder => add-five
10 -> add-five -> io/print-ln

proc compose f g
| x | x -> f -> g

proc double n | n * 2
proc increment n | n + 1

(double -> compose increment) => double-then-increment
7 -> double-then-increment -> io/print-ln

proc apply-twice x f
| x -> f -> f

3 -> apply-twice double -> io/print-ln
3 -> apply-twice (n | n * n) -> io/print-ln
