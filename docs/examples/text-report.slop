~ String handling: words, cases, searching and building text.
"the quick brown fox jumps over the lazy dog" => sentence

sentence -> string/words => words
"{words -> array/length} words" -> io/print-line
"starts with 'the': {sentence -> string/starts-with "the"}" -> io/print-line
"'fox' at index {sentence -> string/index-of "fox"}" -> io/print-line
"'cat' at index {sentence -> string/index-of "cat"}" -> io/print-line

0 => vowels
sentence -> string/each c
| "aeiou" -> string/contains (c -> char/to-string) ? vowels + 1 =>> vowels
"{vowels} vowels" -> io/print-line

sentence -> string/upper -> io/print-line
sentence -> string/replace "the" "a" -> io/print-line
"the" -> string/repeat 3 -> io/print-line
("42" -> string/to-int) + 1 -> io/print-line

"  padded  " -> string/trim => word
word -> string/pad-left 10 `.` -> io/print-line
word -> string/pad-right 10 `.` -> io/print-line
"a👍b" -> string/reverse -> io/print-line
"a👍b" -> string/length -> io/print-line
