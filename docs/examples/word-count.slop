~ Count word frequencies with a hashmap, then report them.
"the cat and the dog and the bird" => text
{} => counts

text -> string/words -> array/each w
| counts -> hashmap/put w ((counts -> hashmap/at-or w 0) + 1)

counts -> io/print-ln
counts -> hashmap/keys -> io/print-ln

counts -> hashmap/entries
-> array/sort-by a b | (a -> array/at 1) > (b -> array/at 1)
-> array/each pair
| "{pair -> array/at 0}: {pair -> array/at 1}" -> io/print-ln

counts -> hashmap/keep k v | v > 1
-> hashmap/keys -> io/print-ln
