~ Makes passwords and a token with the random builtins, and takes its settings from
~ environment variables, so it can be configured without editing it.
~
~   ./bin/slopersons.mjs docs/examples/passwords/passwords.slop
~   PASSWORD_LENGTH=24 PASSWORD_COUNT=5 ./bin/slopersons.mjs docs/examples/passwords/passwords.slop
~
~ Every password has at least one lowercase letter, one uppercase letter, one digit and one
~ symbol; the rest of it is drawn from all four sets. The output changes on every run, so this
~ is not a golden program: test/examples.test.ts checks its shape instead.

"abcdefghijklmnopqrstuvwxyz" -> string/chars => lowercase
"ABCDEFGHIJKLMNOPQRSTUVWXYZ" -> string/chars => uppercase
"0123456789" -> string/chars => digits
"!#$%&*+-=?@^_~" -> string/chars => symbols

proc setting name default
| io/environment -> do -> hashmap/at-or name "" => text
| text = "" ? default -> out
| (attempt | text -> string/to-int recover | nothing) => value
| value = nothing ? "{name} must be a whole number, got \"{text}\"" -> fail
| value

proc password length
| [lowercase uppercase digits symbols] => sets
| (sets -> array/map set | set -> array/pick) => picked
| sets -> array/flatten => everything
| (length - 4) -> int/times
| | picked -> array/push (everything -> array/pick)
| picked -> array/shuffle -> string/from-chars

attempt
| "PASSWORD_LENGTH" -> setting 16 => length
| "PASSWORD_COUNT" -> setting 3 => count
| length < 4 ? "PASSWORD_LENGTH must be at least 4, to fit one character of each kind, got {length}" -> fail
| count < 1 ? "PASSWORD_COUNT must be at least 1, got {count}" -> fail
recover problem
| io/stderr -> stream/write-line (problem -> error/message)
| 2 -> exit

count -> int/times
| length -> password -> io/print-line
"token: {32 -> string/random-hex}" -> io/print-line
