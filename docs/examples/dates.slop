~ Calendar dates: construction, arithmetic, formatting and comparison.
2024 -> date/make 1 31 => start
start -> io/print-line
start -> date/weekday -> io/print-line
start -> date/add-months 1 -> io/print-line
start -> date/add-days 366 -> io/print-line
start -> date/add-years 1 -> io/print-line

"2024-12-25" -> date/parse => christmas
start -> date/days-between christmas -> io/print-line
christmas -> date/format "dddd, mmmm d yyyy" -> io/print-line
christmas -> date/day-of-year -> io/print-line
christmas > start -> io/print-line

[2000 1900 2024 2023] -> array/each y
| "{y} leap: {y -> date/is-leap-year}" -> io/print-line

christmas -> date/end-of-month -> io/print-line
christmas -> date/start-of-month -> date/format "dd/mm/yy" -> io/print-line

~ Times and datetimes.
christmas -> date/at-time (18 -> time/make 30 0) => dinner
dinner -> io/print-line
dinner -> datetime/add-hours 7 -> io/print-line
dinner -> datetime/format "dddd at H:MM" -> io/print-line
"2024-12-31T23:59:59" -> datetime/parse -> datetime/add-seconds 1 -> io/print-line
dinner -> datetime/time -> time/add-minutes 90 -> io/print-line
