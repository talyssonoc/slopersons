~ An interactive user registry: register users with a name and a birthday,
~ and list them. Users are kept in users.json, in the directory the program
~ is run from, so they are still there the next time it runs. Each save writes
~ a temporary file and renames it over users.json, so a crash in the middle of
~ a save never leaves a half-written registry behind. Ids count up and are
~ never reused.

"users.json" => registry-path
"users.json.tmp" => temporary-path

proc ask label
| label -> io/print
| io/read-line -> do => answer
| answer = nothing ? nothing : answer -> string/trim

proc load
| not (registry-path -> file/exists) ? {"next-id": 1  "users": []} -> out
| attempt
| | registry-path -> file/read -> json/parse -> out
| recover e
| | io/stderr -> stream/write-line "{registry-path} cannot be read, so it was left untouched: {e -> error/message}"
| | 1 -> exit

proc save registry
| temporary-path -> file/write (registry -> json/stringify) -> file/rename registry-path

proc ask-choice
| while yes
| | "Register, list or quit? (r/l/q): " -> ask => answer
| | answer = nothing ? "q" -> out
| | answer -> string/lower => answer
| | answer = "r" or answer = "register" ? "r" -> out
| | answer = "l" or answer = "list" ? "l" -> out
| | answer = "q" or answer = "quit" ? "q" -> out
| | "'{answer}' is not r, l or q, try again." -> io/print-line

proc ask-name
| while yes
| | "Name: " -> ask => name
| | name = nothing ? nothing -> out
| | not (name -> string/is-empty) ? name -> out
| | "The name cannot be empty, try again." -> io/print-line

proc ask-birthday
| while yes
| | "Birthday (yyyy-mm-dd): " -> ask => text
| | text = nothing ? nothing -> out
| | (attempt | text -> date/parse recover | nothing) => birthday
| | birthday = nothing ? "'{text}' is not a date written as yyyy-mm-dd, try again." -> io/print-line
| | : birthday > (date/today -> do) ? "A birthday cannot be in the future, try again." -> io/print-line
| | : birthday -> out

proc register registry
| ask-name -> do => name
| name = nothing ? no -> out
| ask-birthday -> do => birthday
| birthday = nothing ? no -> out
| registry -> hashmap/at "next-id" => id
| registry -> hashmap/at "users" -> array/push {"id": id  "name": name  "birthday": (birthday -> date/to-string)}
| registry -> hashmap/put "next-id" (id + 1)
| registry -> save
| "Registered #{id}: {name}, born {birthday -> date/to-string}." -> io/print-line
| yes

proc list registry
| registry -> hashmap/at "users" => users
| users -> array/is-empty ? "No users registered yet." -> io/print-line -> out
| 0 => width
| users -> array/each user
| | user -> hashmap/at "name" -> string/length => length
| | length > width ? length =>> width
| users -> array/each user
| | "#{user -> hashmap/at "id"}" -> string/pad-right 6 ` ` => id
| | user -> hashmap/at "name" -> string/pad-right (width + 2) ` ` => name
| | "{id}{name}{user -> hashmap/at "birthday"}" -> io/print-line

load -> do => registry
"Welcome to the user registry." -> io/print-line
while yes
| ask-choice -> do => choice
| choice = "q" ? stop
| choice = "l" ? registry -> list
| choice = "r" ?
| | registry -> register => going-on
| | not going-on ? stop
"Goodbye." -> io/print-line
