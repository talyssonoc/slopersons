proc parse-int text
| attempt | text -> string/to-int
| recover | nothing

["12" "x" "-3"] -> array/each t
| "{t} -> {t -> parse-int}" -> io/print-line

attempt
| {"a": 1} -> hashmap/at "b"
recover e
| "missing: {e}" -> io/print-line
| "at line {e -> error/line}" -> io/print-line

(attempt | 10 / 0 recover | -1) -> io/print-line

attempt
| "custom" -> fail
recover e
| e -> error/message -> string/upper -> io/print-line

attempt
| attempt | 1 / 0 recover e | "wrapped: {e}" -> fail
recover outer
| outer -> io/print-line

attempt
| "opening" -> io/print-line
| 1 / 0
recover e
| "recovered: {e}" -> io/print-line
always
| "closing" -> io/print-line

attempt | "no error" -> io/print-line always | "closing again" -> io/print-line
