proc parse-int text
| attempt | text -> string/to-int
| recover | nothing

["12" "x" "-3"] -> array/each t
| "{t} -> {t -> parse-int}" -> io/print-ln

attempt
| {"a": 1} -> hashmap/at "b"
recover e
| "missing: {e}" -> io/print-ln
| "at line {e -> error/line}" -> io/print-ln

(attempt | 10 / 0 recover | -1) -> io/print-ln

attempt
| "custom" -> fail
recover e
| e -> error/message -> string/upper -> io/print-ln

attempt
| attempt | 1 / 0 recover e | "wrapped: {e}" -> fail
recover outer
| outer -> io/print-ln
