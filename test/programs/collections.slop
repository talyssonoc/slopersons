[5 3 8 1] => xs
xs -> sort -> print-ln
xs -> print-ln
xs -> push 2 -> print-ln
xs -> pop -> print-ln
xs -> map n | n * 10
-> print-ln
xs -> keep n | n > 3
-> print-ln
xs -> reduce 0 acc n | acc + n
-> print-ln
xs -> any n | n > 7
-> print-ln
xs -> all n | n > 7
-> print-ln
xs -> find n | n > 4
-> print-ln
xs -> index-of 8 -> print-ln
xs -> index-of 9 -> print-ln
xs -> contains 9 -> print-ln
xs -> first -> print-ln
xs -> last -> print-ln
xs -> slice 1 3 -> print-ln
xs -> reverse -> print-ln
xs -> sum -> print-ln
xs -> min -> print-ln
xs -> max -> print-ln
xs -> length -> print-ln
[1 2 2 3 3 3] -> to-set => s
s -> print-ln
s -> add 4 -> has 4 -> print-ln
[3 4 5] -> to-set => t
s -> intersect t -> print-ln
s -> union t -> to-array -> print-ln
s -> difference t -> print-ln
[[1 2] [3 4]] -> flatten -> print-ln
[1 2 3] -> zip ["a" "b"] -> print-ln
["b" "a" "c"] -> sort -> join ", " -> print-ln
[3 1 2] -> with-index -> print-ln
[[1] [1] [2]] -> unique -> print-ln
{"x": 1} => m
m -> put "y" 2 -> print-ln
m -> remove "x" -> print-ln
m -> has "x" -> print-ln
m -> merge {"z": 3} -> values -> print-ln
m -> each k v
| "{k} = {v}" -> print-ln
