{
  "name": "slopersons",
  "version": "0.1.0",
  "description": "Interpreter and standard library for the slopersons programming language",
  "type": "module",
  "bin": {
    "slopersons": "bin/slopersons.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "slopersons": "node bin/slopersons.mjs",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-binary.ts",
    "test:binary": "SLOPERSONS_TEST_BINARY=1 node --test test/binary.test.ts"
  },
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
